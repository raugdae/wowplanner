# Token du bot (Discord Developer Portal > Bot > Reset Token). Ne jamais le committer.
DISCORD_TOKEN=

# Optionnel : ID de ton serveur. Les commandes y apparaissent immédiatement
# (sinon synchronisation globale, qui peut prendre jusqu'à 1 h).
GUILD_ID=

# Optionnel : ID du ou des salons de sorties, séparés par des virgules.
# Si renseigné : /ajouter event ne marche que là, et le bot y supprime tout message
# écrit par un joueur (hors modérateurs). Voir README > « Configurer le salon ».
EVENT_CHANNEL_IDS=

# Fuseau horaire utilisé pour interpréter les dates saisies.
TIMEZONE=Europe/Paris

# Dossier de la base SQLite et du cache des instances.
DATA_DIR=data

# Émotes d'inscription. Unicode, ou émote du serveur au format <:nom:id>.
EMOJI_TANK=🛡️
EMOJI_HEAL=⛑️
EMOJI_DPS=⚔️

# Rappel en MP aux inscrits, N minutes avant le début (0 = désactivé).
REMINDER_MINUTES=30

# Salon vocal temporaire créé N minutes avant le début (0 = désactivé).
# Il est supprimé dès qu'il est vide, au plus tôt 30 min après le début (ou si la sortie est annulée).
# Le bot a besoin de la permission « Gérer les salons ».
VOICE_CHANNEL_MINUTES=15

# Optionnel : ID de la catégorie où créer les salons vocaux.
# Par défaut : la même catégorie que le salon de la sortie.
VOICE_CATEGORY_ID=

# Optionnel : accès à l'API Blizzard pour l'armurerie WoW Forever (stats, métiers…).
# À créer gratuitement sur https://develop.battle.net (Create Client). Ne jamais le committer.
# Test : python -m wowplanner.armory_probe "Prénom Nom"
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Région des serveurs : eu, us, kr ou tw.
BLIZZARD_REGION=eu

# Optionnel : site web public (persos, métiers, recettes — aucune info perso).
# Avec Docker + Traefik : décommente les deux lignes suivantes (voir docker-compose.traefik.yml).
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# WEB_DOMAIN=wow.ton-domaine.fr
# Valeurs Traefik si les tiennes diffèrent : réseau Docker, entrypoint HTTPS, certresolver.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# Sans Docker : port du site (0 = désactivé), et son adresse publique (sinon déduite de WEB_DOMAIN)
# pour que le bot renvoie vers le site dans ses messages.
WEB_PORT=0
# WEB_URL=https://wow.ton-domaine.fr

# Connexion au site avec Discord : réserve le site aux membres du serveur (les pages Donjons restent
# publiques, sans les persos). Vide = site ouvert à tous.
# Discord Developer Portal > ton application > OAuth2 : copie le Client Secret, et ajoute dans « Redirects »
# l'adresse https://wow.ton-domaine.fr/auth/callback (WEB_DOMAIN ou WEB_URL obligatoire). Ne jamais le committer.
DISCORD_CLIENT_SECRET=
# Optionnel : par défaut, l'identifiant de l'application du bot.
# DISCORD_CLIENT_ID=
# Accès invité sans Discord, en lecture seule (voir README) : lien caché /auth/invite/<GUEST_KEY> + mot de passe.
# Vides = désactivé. GUEST_KEY : 16 caractères minimum, au hasard. Ne jamais les committer.
GUEST_KEY=
GUEST_PASSWORD=

# Hôtel des ventes suivi par la page « Hôtel des ventes » du site (clés Blizzard nécessaires). 0 = désactivé.
# Forever range ses hôtels des ventes par numéro (voir README) : 111 = un des hôtels de l'Alliance.
AUCTION_HOUSE_ID=0
# Règle de jeu (1 = JcJ) : n'a pas d'effet sur les prix, Blizzard donne les mêmes hôtels pour toutes.
# AUCTION_RULESET=1
