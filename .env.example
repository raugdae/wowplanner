# Token du bot (Discord Developer Portal > Bot > Reset Token). Ne jamais le committer.
DISCORD_TOKEN=

# Optionnel : ID de ton serveur. Les commandes y apparaissent immédiatement
# (sinon synchronisation globale, qui peut prendre jusqu'à 1 h).
GUILD_ID=

# Optionnel : ID du ou des salons de sorties, séparés par des virgules.
# Si renseigné : /ajouter event ne marche que là, et le bot y supprime tout message
# écrit par un joueur (hors modérateurs). Voir README > « Configurer le salon ».
EVENT_CHANNEL_IDS=

# Fuseau horaire utilisé pour interpréter les dates saisies.
TIMEZONE=Europe/Paris

# Dossier de la base SQLite et du cache des instances.
DATA_DIR=data

# Émotes d'inscription. Unicode, ou émote du serveur au format <:nom:id>.
EMOJI_TANK=🛡️
EMOJI_HEAL=⛑️
EMOJI_DPS=⚔️

# Fréquence de mise à jour de la liste des donjons/raids depuis warcraft.wiki.gg (0 = jamais).
INSTANCES_REFRESH_HOURS=24

# Rappel en MP aux inscrits, N minutes avant le début (0 = désactivé).
REMINDER_MINUTES=30

# Salon vocal temporaire créé N minutes avant le début (0 = désactivé).
# Il est supprimé dès qu'il est vide, au plus tôt 30 min après le début (ou si la sortie est annulée).
# Le bot a besoin de la permission « Gérer les salons ».
VOICE_CHANNEL_MINUTES=15

# Optionnel : ID de la catégorie où créer les salons vocaux.
# Par défaut : la même catégorie que le salon de la sortie.
VOICE_CATEGORY_ID=

# Optionnel : accès à l'API Blizzard pour l'armurerie WoW Forever (stats, métiers…).
# À créer gratuitement sur https://develop.battle.net (Create Client). Ne jamais le committer.
# Test : python -m wowplanner.armory_probe "Prénom Nom"
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Région des serveurs : eu, us, kr ou tw.
BLIZZARD_REGION=eu
